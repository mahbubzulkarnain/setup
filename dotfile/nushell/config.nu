# config.nu: loaded after env.nu (managed by setup, see nushell.sh / windows.nu)
# Aliases and functions ported from the old .zshrc.

$env.config.show_banner = false

# Init files generated by env.nu: starship prompt, zoxide (`z`/`zi`), mise
source ($nu.default-config-dir | path join starship.nu)
source ($nu.default-config-dir | path join zoxide.nu)
use ($nu.default-config-dir | path join mise.nu)

# Git
alias gis = git status
alias gic = git checkout
alias gim = git merge --no-ff
alias gib = git branch
alias gibd = git branch -d
alias gip = git pull origin
alias gipu = git push origin
alias gil = git log --graph --oneline --decorate --all
alias gir = git restore --staged
alias girv = git remote --verbose
alias girrm = git remote rm

# Ignore local changes to a tracked file, and undo it
def giion [file: string] { ^git update-index --assume-unchanged $file }
def giioff [file: string] { ^git update-index --no-assume-unchanged $file }

# Clone a repo and cd into it, e.g. clone github.com/mahbubzulkarnain/setup
def --env clone [url: string] {
    ^git clone $url
    cd ($url | path basename | str replace -r '\.git$' '')
}

# Commits since yesterday (14 days on Mondays) by the current git user
def gils [] {
    let since = if ((date now | format date "%A") == "Monday") { "14 days ago" } else { "yesterday" }
    let author = ($env.AUTHOR? | default (^git config user.name | str trim))
    ^git log --all --since $since --oneline $"--author=($author)"
}

# Kill whatever listens on a port (needs lsof), e.g. pk 3000
def pk [port: int] {
    ^lsof -ti $":($port)" | lines | where {|pid| $pid != "" } | each {|pid| ^kill -9 $pid } | ignore
}

# IP addresses of this machine
def ip [] { sys net | select name ip }

# Ping Google DNS
alias p = ping 8.8.8.8

# Claude Code without permission prompts
def claude [...args: string] { ^claude --dangerously-skip-permissions ...$args }

# Dev server with live reload
alias boom = live-server --host=localhost

# Mkdir and cd
def --env mkcd [dir: string] {
    mkdir $dir
    cd $dir
}

# Docker
alias doi = docker images
alias doirm = docker image rm
alias doils = docker image ls
alias dop = docker pull
alias dol = docker ps -l
alias doc = docker container
alias docls = docker container ls
alias doclog = docker container logs --tail
alias donls = docker network ls
alias dcrun = docker-compose up -d
alias dcrunf = docker-compose up -d --build
alias dcdown = docker-compose down
alias dcdownv = docker-compose down -v
alias dcstop = docker-compose stop
alias dcrestart = docker-compose restart
alias dclog = docker-compose logs -f

# Stop and remove every container
def docstop [] {
    let ids = (^docker ps -aq | lines | where {|id| $id != "" })
    if ($ids | is-not-empty) { ^docker container rm -f ...$ids }
}

# Go
alias gorun = nodemon --exec "go run main.go" --signal SIGTERM
alias gotc = go test ./... -cover
alias got = go test ./... -v
alias goclint = golangci-lint run --fix --enable=revive --enable=gocyclo --enable=goconst --enable=unconvert ./...
alias goslint = staticcheck ./...

# Flutter via FVM
alias flutter = fvm flutter
alias dart = fvm dart
alias pub = fvm pub

# Ruby on Rails and RuboCop
alias r = rails
alias h = heroku
def rdev [...args: string] { ^rails ...$args "RAILS_ENV=development" }
def rprod [...args: string] { ^rails ...$args "RAILS_ENV=production" }
def rtest [...args: string] { ^rails ...$args "RAILS_ENV=test" }
def rce [] { with-env { EDITOR: nano } { ^rails credentials:edit } }
def ru [] {
    ^rubocop -x
    ^rubocop -a
}

# Eject the native-base theme
def inb [] { ^node ./node_modules/native-base/ejectTheme.js }
